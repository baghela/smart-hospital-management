# ---------------------------------------------------------------------------
# Smart Hospital Management System - example configuration
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# ---------------------------------------------------------------------------

APP_NAME="Smart Hospital Management System"
APP_ENV=development
WORKFLOW_ID=smart-hospital-mvp-v1

# --- Database (PostgreSQL is the target datastore) -------------------------
DATABASE_URL=postgresql+psycopg://hospital:hospital@localhost:5432/hospital
# For a quick offline check only (no server required):
# DATABASE_URL=sqlite:///./dev_hospital.db
SQL_ECHO=false

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
TOKEN_TTL_SECONDS=28800
API_BASE_URL=http://localhost:8000

# --- AI providers ----------------------------------------------------------
# Both adapters call the provider's OpenAI-compatible REST endpoint with
# `Authorization: Bearer <API_KEY>`. Providers are tried in this order and the
# chain is used for fallback.
AI_PROVIDER_ORDER=groq,gemini

# Groq
GROQ_API_KEY=your-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini
GEMINI_API_KEY=your-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# TLS for AI calls: the OS certificate store is used by default (truststore),
# which works behind corporate TLS inspection. Optionally point to a CA bundle.
# AI_CA_BUNDLE=C:/path/to/corporate-ca.pem
AI_VERIFY_SSL=true

# --- Token / cost control --------------------------------------------------
MAX_CONTEXT_CHARS=6000
MAX_OUTPUT_TOKENS=400
MAX_HISTORY_TURNS=4
SESSION_TOKEN_BUDGET=40000
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2

# --- Retrieval -------------------------------------------------------------
# "hashing-512" is the dependency-free default. Install the `embeddings` extra
# and set a model name (e.g. sentence-transformers/all-MiniLM-L6-v2) for better
# semantic quality.
EMBEDDING_MODEL=hashing-512
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
HYBRID_ALPHA=0.5
RELEVANCE_THRESHOLD=0.25
CHUNK_CHARS=900
CHUNK_OVERLAP=120

# --- Uploads & rate limiting ----------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXT=.pdf,.docx,.csv,.txt,.md
RATE_LIMIT_PER_MINUTE=30

